# ── Application ────────────────────────────────────────────────────────────────
# Postgres connection string.
# Local dev: postgres://user@localhost:5432/schoolgrads
# Docker/VPS: postgres://crm_user:strongpassword@db:5432/schoolgrads (docker-compose)
# Neon / Supabase: use the pooler connection string they provide.
DATABASE_URL=postgres://user:pass@localhost:5432/schoolgrads

# Session JWT signing secret. MUST be ≥32 random hex chars in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-32-random-bytes-minimum

# ── Runtime ────────────────────────────────────────────────────────────────────
# Set to "production" on VPS / Docker. Required for secure cookie, HSTS, etc.
NODE_ENV=production

# Port the standalone server listens on (default 3000).
PORT=3000

# ── GST Invoice Supplier Block (Rule 46) ───────────────────────────────────────
# Confirm the legal billing entity, GSTIN and PAN with your CA before issuing anything real.
# Without ORG_GSTIN, invoices print "GSTIN-NOT-SET" and the list shows a warning banner.
ORG_NAME=
ORG_ADDRESS=
ORG_GSTIN=
ORG_PAN=
ORG_STATE=Telangana
ORG_EMAIL=
ORG_PHONE=
ORG_BANK=
